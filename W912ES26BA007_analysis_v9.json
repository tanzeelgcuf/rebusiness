  "scope_categories": [
    {
      "category": "Site Preparation",
      "description": "Prepare sites for planting via activities including mowing, broadcast spray, discing, and burning."
    },
    {
      "category": "Seeding and Planting",
      "description": "Plant native trees, grasses, and forbs across three distinct zones: Bank Stabilization, Floodplain Forest, and Oak Savanna, using live stakes, bare-root seedlings, container trees, and specified seed mixes."
    },
    {
      "category": "Invasive Species Removal",
      "description": "Control woody and herbaceous invasive species within designated forest preservation areas using a combination of mechanical and chemical methods."
    },
    {
      "category": "Maintenance and Monitoring",
      "description": "Perform ongoing site maintenance (mowing, spraying, etc.) and conduct annual vegetation monitoring to track progress towards performance standards, submitting annual reports."
    },
    {
      "category": "Boulder Placement",
      "description": "Place approximately 30 boulders across the entrance to Site 38b to prevent vehicular access."
    }
  ],

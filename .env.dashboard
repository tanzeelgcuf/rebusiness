# ThomasNet Dashboard Configuration
# Copy this file to .env and fill in your credentials

# ============================================================================
# THOMASNET ACCOUNT CREDENTIALS (Required)
# ============================================================================
THOMASNET_EMAIL=your_thomasnet_email@example.com
THOMASNET_PASSWORD=your_thomasnet_password

# ============================================================================
# CAPTCHA SOLVER API KEYS (At least one required for DataDome bypass)
# ============================================================================
# Primary solver - faster and more reliable
CAPSOLVER_API_KEY=your_capsolver_api_key_here

# Fallback solver - used if CapSolver fails
TWO_CAPTCHA_API_KEY=your_2captcha_api_key_here

# ============================================================================
# OPTIONAL: MANUAL PROXY (if using specific proxy instead of auto-rotation)
# ============================================================================
THOMASNET_PROXY_SERVER=

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# ============================================================================
# DASHBOARD SETTINGS
# ============================================================================
# Port for Flask web server
DASHBOARD_PORT=5000

# Maximum number of vendors to contact per RFQ (default: 5)
MAX_VENDORS_PER_RFQ=5

# Delay between vendor submissions (seconds)
SUBMISSION_DELAY_MIN=3
SUBMISSION_DELAY_MAX=5

# ============================================================================
# DEPLOYMENT MODE
# ============================================================================
# Set to 'server' for headless mode on cloud deployment
# Set to 'local' or leave empty for headed mode on local machine
DEPLOYMENT_MODE=local

# ============================================================================
# PROXY CONFIGURATION
# ============================================================================
# Enable proxy rotation between vendors
ENABLE_PROXY_ROTATION=True

# Proxy sources to use (comma-separated)
# Options: proxifly, proxyscrape
PROXY_SOURCES=proxifly,proxyscrape

# Minimum working proxies to maintain in pool
MIN_PROXY_POOL_SIZE=10

# Cooldown period for failed proxies (seconds)
PROXY_FAILURE_COOLDOWN=600

# ============================================================================
# DATADOME HANDLING
# ============================================================================
# Strategy for handling DataDome blocks
# Options: adaptive (default), retry_only, pause_and_retry, skip_and_return
DATADOME_STRATEGY=adaptive

# Max retries for a single vendor if DataDome blocks
DATADOME_MAX_RETRIES=3

# Wait time before retrying after DataDome block (seconds)
DATADOME_WAIT_TIME=5

# Time before returning to skipped vendor (seconds)
DATADOME_RETURN_TIME=1800

# ============================================================================
# LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable detailed logging for debugging
VERBOSE_LOGGING=False

# ============================================================================
# DATABASE
# ============================================================================
# Database path (relative to project root)
DATABASE_PATH=rebusiness_automation.db

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Disable DataDome check for testing (not recommended for production)
DISABLE_DATADOME_CHECK=False

# Enable session rotation after N submissions
ENABLE_SESSION_ROTATION=True
SESSION_ROTATION_INTERVAL=50

# Test mode: submit to first vendor only without actually sending
TEST_MODE=False

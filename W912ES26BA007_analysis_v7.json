  "scope_categories": [
    {
      "category": "Site Preparation",
      "description": "Prepare sites for planting and establishment of Floodplain Forest, Bank Stabilization, and Oak Savanna areas. Activities may include mowing, broadcast spray, discing, and burning."
    },
    {
      "category": "Seeding and Planting",
      "description": "Plant native trees, grasses, and forbs across three distinct zones: Bank Stabilization, Floodplain Forest, and Oak Savanna, using specified seed mixes, bare-root seedlings, container trees, and live stakes."
    },
    {
      "category": "Invasive Species Removal and Control",
      "description": "Control woody and herbaceous invasive species within forest preservation areas and planting zones through mechanical or chemical means to meet performance standards."
    },
    {
      "category": "Maintenance and Monitoring",
      "description": "Conduct annual maintenance (mowing, spraying, anti-herbivory measures) and vegetation monitoring for 3 years to ensure successful establishment and meet final performance standards."
    }
  ],
